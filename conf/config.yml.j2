port: __PORT__
host: 127.0.0.1
publicDomain: "__PUBLIC_DOMAIN__"

database:
  path: "__DATA_DIR__/sqlite.db"

storage:
  backend: {{ storage_backend }}
  local:
    dir: "__DATA_DIR__/blobs"
{% if storage_backend == 's3' %}
  s3:
    endpoint: "{{ s3_endpoint }}"
    bucket: "{{ s3_bucket }}"
    accessKey: "{{ s3_access_key }}"
    secretKey: "{{ s3_secret_key }}"
    region: "{{ s3_region }}"
    tmpDir: "__DATA_DIR__/s3-tmp"
{% endif %}

upload:
  enabled: true
  requireAuth: true
  maxSize: __MAX_UPLOAD_SIZE__
  workers: 0

mirror:
  enabled: true
  requireAuth: true

delete:
  requireAuth: true

list:
  enabled: false

media:
  enabled: false
  requireAuth: true
  tmpDir: "__DATA_DIR__/media-tmp"

report:
  enabled: true

landing:
  enabled: true
  title: "__APP__"

dashboard:
  enabled: {{ dashboard_enabled }}
  username: "__ADMIN__"
  password: ""
  lookupRelays:
    - wss://purplepag.es
    - wss://relay.nostr.band
