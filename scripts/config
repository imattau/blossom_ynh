#!/bin/bash

source "$(dirname "$0")/_common.sh"
source /usr/share/yunohost/helpers

# Custom getters so the config panel shows the current preset for these
# two select fields, instead of the raw byte count stored in config.yml
# matching none of the select's choices and rendering blank. Detected by
# name (get__<short_setting>) - no bind wiring needed for these two.
get__max_upload_size() {
	ynh_bytes_to_upload_size_choice "$(ynh_read_var_in_file --file="$install_dir/config.yml" --key=maxSize --after='^upload:')"
}

get__media_max_upload_size() {
	ynh_bytes_to_upload_size_choice "$(ynh_read_var_in_file --file="$install_dir/config.yml" --key=maxSize --after='^media:')"
}

# ynh_write_var_in_file (used by the generic bind-based apply for every
# other field) does its replacement with sed, and sed treats an unescaped
# '&' in a replacement string as "insert the whole match" - any password
# containing '&' gets silently corrupted on write instead of stored as
# typed. Bypass that entirely for this one field: Python's re.sub with a
# function (not a string) as the replacement never interprets backslashes
# or '&' specially, so the password is written back byte-for-byte,
# properly escaped for a YAML double-quoted string.
set__dashboard_password() {
	python3 - "$install_dir/config.yml" "$dashboard_password" << 'PYEOF'
import re
import sys

path, password = sys.argv[1], sys.argv[2]
escaped = password.replace("\\", "\\\\").replace('"', '\\"')

with open(path) as f:
    content = f.read()

content, n = re.subn(
    r'(?m)^(  password: ").*(")$',
    lambda m: m.group(1) + escaped + m.group(2),
    content,
    count=1,
)
if n != 1:
    sys.exit("dashboard password line not found in config.yml")

with open(path, "w") as f:
    f.write(content)
PYEOF
	ynh_app_setting_set --app="$app" --key=dashboard_password --value="$dashboard_password"
}

ynh_app_config_apply() {
	ynh_systemctl --service="$app" --action=stop || true
	_ynh_app_config_apply
	max_upload_size="${max_upload_size:-2147483648}"
	max_upload_size="$(ynh_upload_size_to_bytes "$max_upload_size")"
	max_upload_size_mb=$(( (max_upload_size + 1048575) / 1048576 ))
	MAX_UPLOAD_SIZE_MB="$max_upload_size_mb"
	ynh_write_var_in_file --file="$install_dir/config.yml" --key="maxSize" --after="^upload:" --value="$max_upload_size"

	media_max_upload_size="${media_max_upload_size:-1073741824}"
	media_max_upload_size="$(ynh_upload_size_to_bytes "$media_max_upload_size")"
	ynh_write_var_in_file --file="$install_dir/config.yml" --key="maxSize" --after="^media:" --value="$media_max_upload_size"

	video_profile="${video_profile:-mp4_h264_aac}"
	ynh_write_var_in_file --file="$install_dir/config.yml" --key="format" --after="^  video:" --value="$(ynh_video_profile_to_format "$video_profile")"
	ynh_write_var_in_file --file="$install_dir/config.yml" --key="videoCodec" --after="^  video:" --value="$(ynh_video_profile_to_video_codec "$video_profile")"
	ynh_write_var_in_file --file="$install_dir/config.yml" --key="audioCodec" --after="^  video:" --value="$(ynh_video_profile_to_audio_codec "$video_profile")"

	ynh_config_add_nginx
	ynh_systemctl --service="$app" --action=start --log_path=systemd --wait_until="Blossom Server listening"
}

ynh_app_config_run "$1"
