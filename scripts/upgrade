#!/bin/bash

source "$(dirname "$0")/_common.sh"
source /usr/share/yunohost/helpers

ynh_script_progression "Stopping Blossom Server"
ynh_systemctl --service="$app" --action=stop || true

ynh_script_progression "Updating Blossom Server"
ynh_setup_source --source_id=main --dest_dir="$install_dir" --keep="config.yml,.deno-cache,data"
ynh_setup_source --source_id=deno --dest_dir="$install_dir/.deno"
source_root="$(find "$install_dir" -mindepth 1 -maxdepth 1 -type d -name 'blossom-server-*' -print -quit)"
if [ -n "$source_root" ]; then
	shopt -s dotglob
	mv "$source_root"/* "$install_dir"/
	rmdir "$source_root"
	shopt -u dotglob
fi

export DENO_DIR="$install_dir/.deno-cache"
export PATH="$install_dir/.deno:$PATH"
pushd "$install_dir" >/dev/null
ynh_exec_and_print_stderr_only_if_error "$install_dir/.deno/deno" task build
ynh_exec_and_print_stderr_only_if_error "$install_dir/.deno/deno" cache main.ts
popd >/dev/null

# config.yml is kept as-is across upgrades (it's the config panel's source
# of truth), but is re-rendered here so any field the package has added
# since this app was installed gets a value. Every value below prefers
# whatever is already in the existing config.yml - i.e. any admin
# customization made via the config panel - and only falls back to the
# persisted install setting or an upstream default for a field that
# doesn't exist in the file yet.
ynh_script_progression "Updating Blossom configuration"
public_domain="$(blossom_config_get_or_default publicDomain "" "" "$domain")"
storage_backend="$(blossom_config_get_or_default backend '^storage:' '^upload:' "${storage_backend:-local}")"
s3_endpoint="$(blossom_config_get_or_default endpoint '^storage:' '^upload:' "${s3_endpoint:-https://s3.invalid}")"
s3_bucket="$(blossom_config_get_or_default bucket '^storage:' '^upload:' "${s3_bucket:-not-configured}")"
s3_access_key="$(blossom_config_get_or_default accessKey '^storage:' '^upload:' "${s3_access_key:-not-configured}")"
s3_secret_key="$(blossom_config_get_or_default secretKey '^storage:' '^upload:' "${s3_secret_key:-unset-s3-secret}")"
s3_region="$(blossom_config_get_or_default region '^storage:' '^upload:' "${s3_region:-us-east-1}")"
storage_remove_when_no_owners="$(blossom_config_get_or_default removeWhenNoOwners '^storage:' '^upload:' false)"

default_max_upload_size="$(ynh_upload_size_to_bytes "${max_upload_size:-2147483648}")"
max_upload_size="$(blossom_config_get_or_default maxSize '^upload:' '^mirror:' "$default_max_upload_size")"
max_upload_size_mb=$(( (max_upload_size + 1048575) / 1048576 ))
MAX_UPLOAD_SIZE_MB="$max_upload_size_mb"
upload_require_pubkey_in_rule="$(blossom_config_get_or_default requirePubkeyInRule '^upload:' '^mirror:' false)"
invite_pubkeys="$(ynh_app_setting_get_or_default invite_pubkeys "")"

default_dashboard_enabled=false
if [ "${enable_dashboard:-0}" -eq 1 ]; then default_dashboard_enabled=true; fi
dashboard_enabled="$(blossom_config_get_or_default enabled '^dashboard:' "" "$default_dashboard_enabled")"

# Prefer whatever's already in config.yml (a config-panel change, or a
# password generated by a previous run of this same migration). A blank
# password (every install before this fix) reads back as "" and correctly
# falls through to a freshly generated one, replacing the old
# random-password-every-restart behavior.
dashboard_password="$(blossom_config_get_or_default password '^dashboard:' "" "$(ynh_string_random --length=24)")"
ynh_app_setting_set --app="$app" --key=dashboard_password --value="$dashboard_password"

# See scripts/install for why: without this, SSOwat strips the dashboard's
# Basic Auth header before it ever reaches Blossom, so the password can
# never actually work no matter how correct it is.
ynh_app_setting_set --app="$app" --key=protect_against_basic_auth_spoofing --value=false
# This setting isn't a resource-diffed property, so force SSOwat to
# actually pick it up now rather than relying on some other permission
# change happening to trigger a conf regen later.
ynh_permission_update --permission=main

upload_require_auth="$(blossom_config_get_or_default requireAuth '^upload:' '^mirror:' true)"
mirror_require_auth="$(blossom_config_get_or_default requireAuth '^mirror:' '^delete:' true)"
delete_require_auth="$(blossom_config_get_or_default requireAuth '^delete:' '^list:' true)"
media_require_auth="$(blossom_config_get_or_default requireAuth '^media:' '^report:' true)"
list_require_auth="$(blossom_config_get_or_default requireAuth '^list:' '^media:' false)"
list_allow_list_others="$(blossom_config_get_or_default allowListOthers '^list:' '^media:' true)"

# mirror/list/media "enabled" were hardcoded literals in config.yml.j2
# until now, so a config-panel toggle applied fine to the file at the
# time but got silently reverted back to that literal on the next
# upgrade's re-render. Read back whatever's actually in the file (the
# admin's real current setting, whichever way it was last changed) so
# this upgrade doesn't itself cause that regression.
mirror_enabled="$(blossom_config_get_or_default enabled '^mirror:' '^delete:' true)"
list_enabled="$(blossom_config_get_or_default enabled '^list:' '^media:' false)"
media_enabled="$(blossom_config_get_or_default enabled '^media:' '^report:' false)"

default_landing_title="$app"
landing_title="$(blossom_config_get_or_default title '^landing:' '^dashboard:' "$default_landing_title")"

media_max_upload_size="$(blossom_config_get_or_default maxSize '^media:' '^report:' "$(ynh_upload_size_to_bytes "1 GiB")")"

media_image_quality="$(blossom_config_get_or_default quality '^  image:' '^  video:' 90)"
media_image_progressive="$(blossom_config_get_or_default progressive '^  image:' '^  video:' true)"
media_image_max_width="$(blossom_config_get_or_default maxWidth '^  image:' '^  video:' 1920)"
media_image_max_height="$(blossom_config_get_or_default maxHeight '^  image:' '^  video:' 1080)"
media_image_output_format="$(blossom_config_get_or_default outputFormat '^  image:' '^  video:' webp)"
media_image_maintain_aspect_ratio="$(blossom_config_get_or_default maintainAspectRatio '^  image:' '^  video:' true)"
media_image_keep_exif="$(blossom_config_get_or_default keepExif '^  image:' '^  video:' false)"
media_image_fps="$(blossom_config_get_or_default fps '^  image:' '^  video:' 30)"

media_video_quality="$(blossom_config_get_or_default quality '^  video:' '^report:' 90)"
media_video_max_height="$(blossom_config_get_or_default maxHeight '^  video:' '^report:' 1080)"
media_video_max_fps="$(blossom_config_get_or_default maxFps '^  video:' '^report:' 30)"

video_profile="$(ynh_app_setting_get_or_default video_profile mp4_h264_aac)"
media_video_format="$(ynh_video_profile_to_format "$video_profile")"
media_video_codec="$(ynh_video_profile_to_video_codec "$video_profile")"
media_audio_codec="$(ynh_video_profile_to_audio_codec "$video_profile")"

ynh_config_add --jinja --template="config.yml.j2" --destination="$install_dir/config.yml"
chmod 0640 "$install_dir/config.yml"

chown -R "$app:$app" "$install_dir" "$data_dir"
yunohost service add "$app" --description="Blossom blob storage server" --log="/var/log/$app/$app.log"
ynh_config_add_systemd --service="$app" --template="systemd.service"
ynh_config_add_nginx
ynh_systemctl --service="$app" --action=start --log_path=systemd --wait_until="Blossom Server listening"
